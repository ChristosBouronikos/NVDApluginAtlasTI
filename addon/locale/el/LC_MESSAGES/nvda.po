msgid "NVDA+Control+Alt+M: Memo Manager"
msgstr "NVDA+Control+Alt+M: Διαχειριστής Σημειωμάτων"

#: addon/appModules/atlas.py:1321
msgid "NVDA+Control+Alt+N: Network Manager"
