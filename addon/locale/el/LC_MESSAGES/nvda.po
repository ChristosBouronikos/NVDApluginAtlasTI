#: addon/appModules/atlas.py:1322
msgid "NVDA+Control+Alt+L: Link Manager"
msgstr "NVDA+Control+Alt+L: Διαχειριστής Συνδέσεων"

#: addon/appModules/atlas.py:1323
msgid "NVDA+Control+Alt+P: Project Navigator"
msgstr "NVDA+Control+Alt+P: Πλοηγός Έργου"

