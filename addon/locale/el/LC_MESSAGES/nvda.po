msgid "NVDA+Control+Alt+Shift+A: Margin area contents"
msgstr "NVDA+Control+Alt+Shift+A: Περιεχόμενα περιοχής περιθωρίου"

#: addon/appModules/atlas.py:1340
msgid "NVDA+Control+Alt+Shift+N: Comment or preview pane"
msgstr "NVDA+Control+Alt+Shift+N: Πλαίσιο σχολίου ή προεπισκόπησης"

#: addon/appModules/atlas.py:1341
msgid "NVDA+Control+Alt+Shift+V: Describe the current chart or diagram"
msgstr ""
"NVDA+Control+Alt+Shift+V: Περιγραφή του τρέχοντος γραφήματος ή διαγράμματος"

#: addon/appModules/atlas.py:1342
msgid "NVDA+Control+Alt+Shift+J: Jump to the accessible data view of a chart"
msgstr ""
"NVDA+Control+Alt+Shift+J: Μετάβαση στην προσβάσιμη προβολή δεδομένων ενός "
"γραφήματος"

#: addon/appModules/atlas.py:1343
msgid "NVDA+Control+Alt+Shift+C: Focused code"
msgstr "NVDA+Control+Alt+Shift+C: Εστιασμένος κωδικός"

#: addon/appModules/atlas.py:1344
msgid "NVDA+Control+Alt+Shift+Q: Focused quotation"
msgstr "NVDA+Control+Alt+Shift+Q: Εστιασμένο απόσπασμα"

#: addon/appModules/atlas.py:1345
msgid "NVDA+Control+Alt+Shift+D: Current document"
msgstr "NVDA+Control+Alt+Shift+D: Τρέχον έγγραφο"

#: addon/appModules/atlas.py:1348
msgid "LANGUAGE AND HELP"
msgstr "ΓΛΩΣΣΑ ΚΑΙ ΒΟΗΘΕΙΑ"

#: addon/appModules/atlas.py:1349
msgid "NVDA+Control+Alt+Shift+G: Glossary of Atlas.ti terms"
msgstr "NVDA+Control+Alt+Shift+G: Γλωσσάρι όρων Atlas.ti"

#: addon/appModules/atlas.py:1350
msgid "NVDA+Control+Alt+Shift+L: Switch between English and Greek"
msgstr "NVDA+Control+Alt+Shift+L: Εναλλαγή μεταξύ Αγγλικών και Ελληνικών"

#: addon/appModules/atlas.py:1351
msgid "NVDA+Control+Alt+Shift+H: This command list"
msgstr "NVDA+Control+Alt+Shift+H: Αυτή η λίστα εντολών"

#: addon/appModules/atlas.py:1352
msgid "NVDA+Control+Alt+Shift+I: Log diagnostic information"
msgstr "NVDA+Control+Alt+Shift+I: Καταγραφή διαγνωστικών πληροφοριών"

#: addon/appModules/atlas.py:1353
msgid "NVDA+Control+Alt+Shift+U: Privacy-filtered UI tree capture"
msgstr ""
"NVDA+Control+Alt+Shift+U: Καταγραφή δέντρου διεπαφής με φίλτρο απορρήτου"

#: addon/appModules/atlas.py:1356
msgid "ATLAS.TI SHORTCUTS"
msgstr "ΣΥΝΤΟΜΕΥΣΕΙΣ ATLAS.TI"

#: addon/appModules/atlas.py:1357
msgid "Control+J: Apply codes to the selected segment"
msgstr "Control+J: Εφαρμογή κωδικών στο επιλεγμένο τμήμα"

#: addon/appModules/atlas.py:1358
msgid "Control+K: Create new codes"
msgstr "Control+K: Δημιουργία νέων κωδικών"

#: addon/appModules/atlas.py:1359
msgid "Control+S: Save the project"
msgstr "Control+S: Αποθήκευση του έργου"

#: addon/appModules/atlas.py:1362
msgid "Atlas.ti accessibility commands"
msgstr "Εντολές προσβασιμότητας Atlas.ti"

#: addon/appModules/atlas.py:1366
msgid "Switch the add-on speech language between English and Greek"
msgstr ""
"Εναλλαγή της γλώσσας ομιλίας της πρόσθετης λειτουργίας μεταξύ Αγγλικών και "
"Ελληνικών"

#: addon/appModules/atlas.py:1380
msgid "Speech language: automatic"
msgstr "Γλώσσα ομιλίας: αυτόματη"

#: addon/appModules/atlas.py:1383
msgid "Speech language: Greek"
msgstr "Γλώσσα ομιλίας: Ελληνικά"

#: addon/appModules/atlas.py:1386
msgid "Speech language: English"
msgstr "Γλώσσα ομιλίας: Αγγλικά"

#: addon/appModules/atlas.py:1391
#, python-brace-format
msgid "Atlas.ti interface language: {language}"
msgstr "Γλώσσα διεπαφής Atlas.ti: {language}"

#: addon/appModules/atlas.py:1397
msgid "Write diagnostic information about the focused control to the NVDA log"
msgstr ""
"Καταγραφή διαγνωστικών πληροφοριών για το εστιασμένο στοιχείο στο αρχείο "
"καταγραφής του NVDA"

#: addon/appModules/atlas.py:1416
msgid "Diagnostic information written to the NVDA log"
msgstr ""
"Οι διαγνωστικές πληροφορίες καταγράφηκαν στο αρχείο καταγραφής του NVDA"

#: addon/appModules/atlas.py:1479
msgid "Capture the privacy-filtered ATLAS.ti control tree in the NVDA log"
msgstr ""
"Καταγραφή του δέντρου στοιχείων ελέγχου του ATLAS.ti με φίλτρο απορρήτου στο "
"αρχείο καταγραφής του NVDA"

#: addon/appModules/atlas.py:1486
msgid ""
"UI tree capture is disabled. Enable privacy-filtered UI tree capture in NVDA "
"Settings, Atlas.ti."
msgstr ""
"Η καταγραφή του δέντρου διεπαφής είναι απενεργοποιημένη. Ενεργοποιήστε την "
"καταγραφή δέντρου διεπαφής με φίλτρο απορρήτου στις Ρυθμίσεις NVDA, Atlas.ti."

#: addon/appModules/atlas.py:1497
