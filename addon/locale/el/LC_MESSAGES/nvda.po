#: addon/appModules/atlas.py:278 addon/globalPlugins/atlastiHelper.py:189
msgid "Atlas.ti"
msgstr "Atlas.ti"

#: addon/appModules/atlas.py:372
#, python-brace-format
msgid "shortcut {keys}"
msgstr "συντόμευση {keys}"

#: addon/appModules/atlas.py:808
msgid "Go to the Document Manager"
msgstr "Μετάβαση στον Διαχειριστή Εγγράφων"

#: addon/appModules/atlas.py:816
msgid "Go to the Code Manager"
msgstr "Μετάβαση στον Διαχειριστή Κωδικών"

#: addon/appModules/atlas.py:824
msgid "Go to the Quotation Manager"
msgstr "Μετάβαση στον Διαχειριστή Αποσπασμάτων"

#: addon/appModules/atlas.py:832
msgid "Go to the Memo Manager"
msgstr "Μετάβαση στον Διαχειριστή Σημειωμάτων"

#: addon/appModules/atlas.py:840
msgid "Go to the Network Manager"
msgstr "Μετάβαση στον Διαχειριστή Δικτύων"

#: addon/appModules/atlas.py:848
msgid "Go to the Link Manager"
msgstr "Μετάβαση στον Διαχειριστή Συνδέσεων"

#: addon/appModules/atlas.py:856
msgid "Go to the Project Navigator"
msgstr "Μετάβαση στον Πλοηγό Έργου"

#: addon/appModules/atlas.py:864
msgid "Go to the ribbon"
msgstr "Μετάβαση στην κορδέλα"

#: addon/appModules/atlas.py:872
msgid "Go to the margin area"
msgstr "Μετάβαση στην περιοχή περιθωρίου"

#: addon/appModules/atlas.py:880
msgid "Go to the working area"
msgstr "Μετάβαση στην περιοχή εργασίας"

#: addon/appModules/atlas.py:888
msgid "Go to the comment pane"
msgstr "Μετάβαση στο πλαίσιο σχολίου"

#: addon/appModules/atlas.py:896
msgid "Go to the side panel with groups and filters"
msgstr "Μετάβαση στο πλαϊνό πλαίσιο ομάδων και φίλτρων"

#: addon/appModules/atlas.py:904
msgid "Move to the next Atlas.ti panel"
msgstr "Μετάβαση στον επόμενο πίνακα του Atlas.ti"

#: addon/appModules/atlas.py:912
msgid "Move to the previous Atlas.ti panel"
msgstr "Μετάβαση στον προηγούμενο πίνακα του Atlas.ti"

#: addon/appModules/atlas.py:924
msgid "Describe the focused Atlas.ti control in detail"
msgstr "Λεπτομερής περιγραφή του εστιασμένου στοιχείου ελέγχου του Atlas.ti"

#: addon/appModules/atlas.py:931
msgid "Nothing is focused"
msgstr "Δεν υπάρχει εστίαση σε κάποιο στοιχείο"

#: addon/appModules/atlas.py:954
#, python-brace-format
msgid "in {path}"
msgstr "στο {path}"

#: addon/appModules/atlas.py:958
msgid "This control provides no information to the screen reader"
msgstr "Αυτό το στοιχείο ελέγχου δεν παρέχει πληροφορίες στον αναγνώστη οθόνης"

#: addon/appModules/atlas.py:964
msgid "Announce the current Atlas.ti panel"
msgstr "Ανακοίνωση του τρέχοντος πίνακα του Atlas.ti"

#: addon/appModules/atlas.py:972
#, python-brace-format
msgid "Current panel: {panel}"
msgstr "Τρέχων πίνακας: {panel}"

#: addon/appModules/atlas.py:978
#, python-brace-format
msgid "Panel unknown. Last panel reached with a command: {panel}"
msgstr ""
"Άγνωστος πίνακας. Τελευταίος πίνακας στον οποίο έγινε μετάβαση με εντολή: "
"{panel}"

#: addon/appModules/atlas.py:982
msgid "Unable to determine the current panel"
msgstr "Δεν ήταν δυνατός ο προσδιορισμός του τρέχοντος πίνακα"

#: addon/appModules/atlas.py:986
msgid "Read every column of the current row"
msgstr "Ανάγνωση όλων των στηλών της τρέχουσας γραμμής"

#: addon/appModules/atlas.py:994
msgid "Focus is not on a list row"
msgstr "Η εστίαση δεν βρίσκεται σε γραμμή λίστας"

#: addon/appModules/atlas.py:1006
msgid "This row has no readable content"
msgstr "Αυτή η γραμμή δεν έχει αναγνώσιμο περιεχόμενο"

#: addon/appModules/atlas.py:1012
msgid "Report the item count and status bar of the current list"
msgstr ""
"Αναφορά του αριθμού στοιχείων και της γραμμής κατάστασης της τρέχουσας λίστας"

#: addon/appModules/atlas.py:1026
#, python-brace-format
msgid "{count} items"
msgstr "{count} στοιχεία"

#: addon/appModules/atlas.py:1034
msgid "No status information available"
msgstr "Δεν υπάρχουν διαθέσιμες πληροφορίες κατάστασης"

#: addon/appModules/atlas.py:1040
msgid "List the controls on the current ribbon tab"
msgstr "Λίστα στοιχείων ελέγχου της τρέχουσας καρτέλας της κορδέλας"

#: addon/appModules/atlas.py:1048
msgid "The ribbon could not be found"
msgstr "Δεν ήταν δυνατή η εύρεση της κορδέλας"

#: addon/appModules/atlas.py:1074
msgid "No ribbon controls are exposed to the screen reader"
msgstr "Δεν εκτίθενται στοιχεία ελέγχου της κορδέλας στον αναγνώστη οθόνης"

#: addon/appModules/atlas.py:1078
msgid "Atlas.ti ribbon"
msgstr "Κορδέλα Atlas.ti"

#: addon/appModules/atlas.py:1081
#, python-brace-format
msgid "Atlas.ti ribbon: {tab}"
msgstr "Κορδέλα Atlas.ti: {tab}"

#: addon/appModules/atlas.py:1086
msgid "Read the codes and memos in the margin area"
msgstr "Ανάγνωση κωδικών και σημειωμάτων στην περιοχή περιθωρίου"

#: addon/appModules/atlas.py:1094
msgid "The margin area could not be found. Open a document first."
msgstr ""
"Δεν ήταν δυνατή η εύρεση της περιοχής περιθωρίου. Ανοίξτε πρώτα ένα έγγραφο."

#: addon/appModules/atlas.py:1105
msgid "The margin area is empty or not readable"
msgstr "Η περιοχή περιθωρίου είναι κενή ή μη αναγνώσιμη"

#: addon/appModules/atlas.py:1108
msgid "Atlas.ti margin area"
msgstr "Περιοχή περιθωρίου Atlas.ti"

#: addon/appModules/atlas.py:1112
msgid "Read the comment or preview pane"
msgstr "Ανάγνωση του πλαισίου σχολίου ή προεπισκόπησης"

#: addon/appModules/atlas.py:1120
msgid "No comment or preview pane was found"
msgstr "Δεν βρέθηκε πλαίσιο σχολίου ή προεπισκόπησης"

#: addon/appModules/atlas.py:1130
msgid "The comment pane is empty"
msgstr "Το πλαίσιο σχολίου είναι κενό"

#: addon/appModules/atlas.py:1136
msgid "Describe the current chart or diagram, and try to read its contents"
msgstr ""
"Περιγραφή του τρέχοντος γραφήματος ή διαγράμματος, με προσπάθεια ανάγνωσης "
"του περιεχομένου του"

#: addon/appModules/atlas.py:1148 addon/appModules/atlas.py:1184
msgid "The focused control is not a chart, diagram, or visual-only view."
msgstr ""
"Το εστιασμένο στοιχείο δεν είναι γράφημα, διάγραμμα ή προβολή μόνο-οπτικού "
"περιεχομένου."

#: addon/appModules/atlas.py:1155
#, python-brace-format
msgid "{chart}: accessible content found"
msgstr "{chart}: βρέθηκε προσβάσιμο περιεχόμενο"

#: addon/appModules/atlas.py:1164
msgid ""
"Atlas.ti does not expose the individual contents of this element to the "
"screen reader."
msgstr ""
"Το Atlas.ti δεν εκθέτει τα επιμέρους περιεχόμενα αυτού του στοιχείου στον "
"αναγνώστη οθόνης."

#: addon/appModules/atlas.py:1169
#, python-brace-format
msgid ""
"For the same data as readable text, use {alternative}. Press "
"NVDA+Ctrl+Alt+Shift+J to jump there now."
msgstr ""
"Για τα ίδια δεδομένα ως αναγνώσιμο κείμενο, χρησιμοποιήστε: {alternative}. "
"Πατήστε NVDA+Ctrl+Alt+Shift+J για άμεση μετάβαση εκεί."

#: addon/appModules/atlas.py:1176
msgid "Jump to the accessible data view of the current chart or diagram"
msgstr ""
"Μετάβαση στην προσβάσιμη προβολή δεδομένων του τρέχοντος γραφήματος ή "
"διαγράμματος"

#: addon/appModules/atlas.py:1189
#, python-brace-format
msgid "No accessible alternative is known for {chart}."
msgstr "Δεν είναι γνωστή προσβάσιμη εναλλακτική για: {chart}."

#: addon/appModules/atlas.py:1197
msgid "Read the focused code"
msgstr "Ανάγνωση του εστιασμένου κωδικού"

#: addon/appModules/atlas.py:1204
#, python-brace-format
msgid "Code: {name}"
msgstr "Κωδικός: {name}"

#: addon/appModules/atlas.py:1206
msgid "Focus is not on a code. Open the Code Manager or the code list first."
msgstr ""
"Η εστίαση δεν βρίσκεται σε κωδικό. Ανοίξτε πρώτα τον Διαχειριστή Κωδικών ή "
"τη λίστα κωδικών."

#: addon/appModules/atlas.py:1211
msgid "Read the focused quotation"
msgstr "Ανάγνωση του εστιασμένου αποσπάσματος"

#: addon/appModules/atlas.py:1218
#, python-brace-format
msgid "Quotation: {name}"
msgstr "Απόσπασμα: {name}"

#: addon/appModules/atlas.py:1220
msgid ""
"Focus is not on a quotation. Open the Quotation Manager or the Quotation "
"Reader first."
msgstr ""
"Η εστίαση δεν βρίσκεται σε απόσπασμα. Ανοίξτε πρώτα τον Διαχειριστή "
"Αποσπασμάτων ή τον Αναγνώστη Αποσπασμάτων."

#: addon/appModules/atlas.py:1226
msgid "Read the current document"
msgstr "Ανάγνωση του τρέχοντος εγγράφου"

#: addon/appModules/atlas.py:1234 addon/appModules/atlas.py:1239
#, python-brace-format
msgid "Document: {name}"
msgstr "Έγγραφο: {name}"

#: addon/appModules/atlas.py:1245
#, python-brace-format
msgid "No document identified. Window title: {name}"
msgstr "Δεν εντοπίστηκε έγγραφο. Τίτλος παραθύρου: {name}"

#: addon/appModules/atlas.py:1249
msgid "No document information available"
msgstr "Δεν υπάρχουν διαθέσιμες πληροφορίες εγγράφου"

#: addon/appModules/atlas.py:1257
msgid "Show the Atlas.ti term glossary in English and Greek"
msgstr "Εμφάνιση του γλωσσαρίου όρων Atlas.ti στα Αγγλικά και Ελληνικά"

#: addon/appModules/atlas.py:1267
msgid "Ribbon tabs"
msgstr "Καρτέλες κορδέλας"

#: addon/appModules/atlas.py:1269
msgid "Managers"
msgstr "Διαχειριστές"

#: addon/appModules/atlas.py:1271
msgid "Windows and tools"
