#: addon/appModules/atlas.py:1330
msgid "NVDA+Control+Alt+Page up: Previous panel"
msgstr "NVDA+Control+Alt+Page up: Προηγούμενος πίνακας"

#: addon/appModules/atlas.py:1333
msgid "READING"
msgstr "ΑΝΑΓΝΩΣΗ"

#: addon/appModules/atlas.py:1334
msgid "NVDA+Control+Alt+Shift+E: Describe the focused control"
msgstr "NVDA+Control+Alt+Shift+E: Περιγραφή του εστιασμένου στοιχείου"

#: addon/appModules/atlas.py:1335
msgid "NVDA+Control+Alt+Shift+P: Current panel"
msgstr "NVDA+Control+Alt+Shift+P: Τρέχων πίνακας"

#: addon/appModules/atlas.py:1336
msgid "NVDA+Control+Alt+Shift+R: All columns of the current row"
msgstr "NVDA+Control+Alt+Shift+R: Όλες οι στήλες της τρέχουσας γραμμής"

#: addon/appModules/atlas.py:1337
msgid "NVDA+Control+Alt+Shift+S: Item count and status bar"
msgstr "NVDA+Control+Alt+Shift+S: Αριθμός στοιχείων και γραμμή κατάστασης"

#: addon/appModules/atlas.py:1338
msgid "NVDA+Control+Alt+Shift+T: Controls on the current ribbon tab"
msgstr ""
